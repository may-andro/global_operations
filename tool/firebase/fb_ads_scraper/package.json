    "firebase-admin": "^11.10.0",
    "firebase-functions": "^4.9.0",
    "tough-cookie": "^4.1.4"
  },
  "devDependencies": {
    "@types/tough-cookie": "^4.0.5",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "typescript": "^5.4.0"
  },
  "private": true
}



